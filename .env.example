
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_API_ROLE=owner
CLIENT_ORIGIN=https://your-domain.example
NERKH_API_TOKEN=replace-with-nerkh-token
RESEND_API_KEY=replace-with-resend-api-key
NOTIFICATION_FROM_EMAIL=notifications@your-domain.example
SMS_PROVIDER_WEBHOOK_URL=
SMS_PROVIDER_AUTH_TOKEN=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_AUTH_TOKEN=
BACKUP_STORAGE_URL_TEMPLATE=https://storage.example.invalid/zarinsa/{key}
BACKUP_STORAGE_AUTH_TOKEN=
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-character-key
BACKUP_STORAGE_INDEPENDENT=false
BACKUP_REMOTE_REQUIRED=true
RESTORE_DATABASE_URL=postgresql://user:password@separate-recovery-host/recovery_database?sslmode=verify-full
RESTORE_DATABASE_NAME=recovery_database
BACKUP_OBJECT_KEY=
CONFIRM_PREPARE_RECOVERY_TARGET=NO
CONFIRM_RESTORE=NO
CONFIRM_RECOVERY_TEST=NO
CONFIRM_RECOVERY_DRILL=NO
